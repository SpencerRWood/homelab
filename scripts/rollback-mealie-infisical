#!/bin/sh
set -eu

compose_dir=/srv/homelab/compose/productivity/recipes
legacy_file="$compose_dir/compose.pre-infisical.yml"
global_env=/srv/homelab/secrets/homelab.env

if [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'Run as root' >&2
  exit 1
fi
if [ ! -f "$legacy_file" ] || [ ! -f "$global_env" ]; then
  printf '%s\n' 'Mealie rollback sources are unavailable' >&2
  exit 1
fi
if systemctl cat homelab-infisical@mealie.service >/dev/null 2>&1; then
  systemctl disable --now homelab-infisical@mealie.service >/dev/null 2>&1 || {
    printf '%s\n' 'Could not disable Mealie Infisical boot unit' >&2
    exit 1
  }
fi
docker compose --env-file "$global_env" -f "$legacy_file" config --quiet >/dev/null 2>&1 || {
  printf '%s\n' 'Mealie rollback Compose validation failed' >&2
  exit 1
}
docker compose --env-file "$global_env" -f "$legacy_file" up -d --force-recreate --no-deps mealie >/dev/null 2>&1 || {
  printf '%s\n' 'Mealie rollback failed' >&2
  exit 1
}
printf '%s\n' 'Mealie restored from retained legacy source'
