#!/bin/sh
set -eu

compose_dir=/srv/homelab/compose/productivity/recipes
legacy_file="$compose_dir/compose.pre-infisical.yml"
canary_file="$compose_dir/compose.infisical.yml"
global_env=/srv/homelab/secrets/homelab.env

if [ "$(id -u)" -ne 0 ]; then
  printf '%s\n' 'Run as root' >&2
  exit 1
fi
if [ ! -f "$legacy_file" ]; then
  install -o root -g root -m 0644 "$compose_dir/compose.yml" "$legacy_file"
fi

/usr/local/sbin/resolve-mealie-secret.py
docker compose --env-file "$global_env" -f "$canary_file" config --quiet >/dev/null 2>&1 || {
  printf '%s\n' 'Mealie Compose validation failed' >&2
  exit 1
}
if [ "${1:-}" = '--recreate' ]; then
  docker compose --env-file "$global_env" -f "$canary_file" up -d --force-recreate --no-deps mealie >/dev/null 2>&1 || {
    printf '%s\n' 'Mealie deployment failed' >&2
    exit 1
  }
else
  docker compose --env-file "$global_env" -f "$canary_file" up -d --no-deps mealie >/dev/null 2>&1 || {
    printf '%s\n' 'Mealie deployment failed' >&2
    exit 1
  }
fi
printf '%s\n' 'Mealie deployed from Infisical homelab:/mealie'
