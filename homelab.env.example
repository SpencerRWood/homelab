# Canonical control-node secret contract. Copy this ignored file to homelab.env,
# populate values through the approved secret workflow, and let direnv load it.
# Ansible deploys it as /srv/homelab/secrets/homelab.env with mode 0600.
# Names only: never commit values, placeholders, URLs, or defaults here.

