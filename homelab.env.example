# Runtime secret contract. Copy outside Git as /srv/homelab/secrets/homelab.env.
# Values shown here are placeholders only.

# Ingress and certificates
CLOUDFLARE_API_TOKEN=replace-me
ACME_EMAIL=admin@example.invalid

# Media and service API credentials
# Preserves the legacy Plex environment-variable name during canonical migration.
PLEX_CLAIM=replace-me-if-required
SONARR_API_KEY=replace-me
RADARR_API_KEY=replace-me
SABNZBD_API_KEY=replace-me
PROWLARR_API_KEY=replace-me

# Platform services
GRAFANA_ADMIN_USER=replace-me
GRAFANA_ADMIN_PASSWORD=replace-me
VAULTWARDEN_ADMIN_TOKEN=replace-me
VAULTWARDEN_DATABASE_URL=replace-me

# Home applications and databases
MEALIE_API_KEY=replace-me
VIKUNJA_JWT_SECRET=replace-me
VIKUNJA_DATABASE_URL=replace-me
OPENPROJECT_SECRET_KEY_BASE=replace-me
OPENPROJECT_DATABASE_URL=replace-me
OVERLEAF_SESSION_SECRET=replace-me
OVERLEAF_DATABASE_URL=replace-me

# Retained-service notifications and integration credentials
HOME_SERVICE_NOTIFICATION_API_TOKEN=replace-me
HOME_SERVICE_API_CREDENTIAL=replace-me
