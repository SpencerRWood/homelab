{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["docker-compose", "dockerfile", "custom.regex"],
  "docker-compose": {
    "managerFilePatterns": ["/^compose/.*\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Manage external image tag defaults that Compose extraction skips as variables.",
      "managerFilePatterns": ["/^compose/.*\\.ya?ml$/"],
      "matchStrings": [
        "image:[ \\t]+(?<depName>[^\\s:$]+(?:/[^\\s:$]+)*):\\$\\{(?<depType>[A-Z_]+):-(?<currentValue>[^@}\\s]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\\}"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "image: {{depName}}:{{{replace '^.*$' '${' depType}}}{{depType}}:-{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}{{{replace '^.*$' '}' depType}}}"
    },
    {
      "customType": "regex",
      "description": "Pin and refresh Caddy FROM digests in the existing version channel; shared-ARG version upgrades require a separate coordinated review.",
      "managerFilePatterns": ["/^compose/platform/caddy/Dockerfile$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "ARG CADDY_VERSION=(?<caddyVersion>[^\\s]+)[\\s\\S]*",
        "FROM (?<depName>caddy):\\$\\{CADDY_VERSION\\}-(?<depType>builder|alpine)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "currentValueTemplate": "{{caddyVersion}}-{{depType}}",
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "FROM caddy:{{{replace '^.*$' '${CADDY_VERSION}' depType}}}-{{depType}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Calibre-Web's LinuxServer mod is also an OCI image; its loader supports tag plus digest.",
      "managerFilePatterns": ["/^compose/books/compose\\.yml$/"],
      "matchStrings": [
        "DOCKER_MODS:[ \\t]+(?<depName>linuxserver/mods):(?<currentValue>universal-calibre)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "datasourceTemplate": "docker",
      "autoReplaceStringTemplate": "DOCKER_MODS: {{depName}}:{{newValue}}{{#if newDigest}}@{{newDigest}}{{/if}}"
    }
  ],
  "semanticCommits": "enabled",
  "semanticCommitType": "fix",
  "semanticCommitScope": "deps",
  "pinDigests": true,
  "platformAutomerge": true,
  "automergeStrategy": "squash",
  "rebaseWhen": "behind-base-branch",
  "vulnerabilityAlerts": {
    "semanticCommitType": "chore",
    "semanticCommitScope": "deps"
  },
  "packageRules": [
    {
      "description": "Only digest pins, digest refreshes, patch and minor images qualify for routine delivery after CI.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["pinDigest", "digest", "patch", "minor"],
      "automerge": true,
      "pinDigests": true,
      "groupName": "Routine image updates"
    },
    {
      "description": "Changing Caddy's shared ARG and both pinned FROM variants is unsupported by Renovate's atomic replacement; retain digest maintenance and block tag upgrades pending a coordinated build-contract change.",
      "matchManagers": ["custom.regex"],
      "matchPackageNames": ["caddy"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "enabled": false
    },
    {
      "description": "Protected applications and permission-changing init helpers require manual review for every image change.",
      "matchPackageNames": ["busybox", "openproject/openproject", "openproject/hocuspocus", "vaultwarden/server", "ghcr.io/mealie-recipes/mealie", "vikunja/vikunja"],
      "groupName": "{{depName}} image update",
      "automerge": false
    },
    {
      "description": "Standard Dockerfile replacement cannot update Caddy's shared ARG with tag suffixes; the scoped custom managers own this file.",
      "matchManagers": ["dockerfile"],
      "matchFileNames": ["compose/platform/caddy/Dockerfile"],
      "enabled": false
    },
    {
      "description": "Locally built output names are not registry dependencies; their Dockerfile bases are managed.",
      "matchPackageNames": ["local/caddy-cloudflare", "code-server-codex"],
      "enabled": false
    },
    {
      "description": "Potentially incompatible major image upgrades require manual review.",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "All PostgreSQL image changes require persistent-state and compatibility review.",
      "matchPackageNames": ["pgvector/pgvector"],
      "groupName": "{{depName}} image update",
      "automerge": false
    }
  ]
}
